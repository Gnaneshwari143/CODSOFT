import React, { useState } from 'react';
// import { createResource } from '../api/resource'; // Uncomment when ready to connect to backend

interface Resource {
    // 'name' is now a dropdown with specific options
    name: 'Red Dress' | 'Wooden Staff' | 'Arri Camera' | 'Boom Mic' | 'Tripod' | 'Catering Van' | 'Actor Trailer' | 'Lunch for 50' | 'Sound Mixer' | 'Lighting Kit' | 'Clapperboard' | 'Makeup Kit';
    type: 'Personnel' | 'Equipment' | 'Location' | 'Wardrobe' | 'Props' | 'Set Decoration' | 'Vehicles' | 'Catering' | 'Supplies' | 'Miscellaneous';
    availability: 'Available' | 'Unavailable' | 'In Use' | 'Maintenance' | 'Booked' | 'Needs Repair';
    // id?: number;
}

const ResourceManagement: React.FC = () => {
    const [resources, setResources] = useState<Resource[]>([]);
    const [newResource, setNewResource] = useState<Resource>({
        name: "Arri Camera", // Default name option
        type: "Equipment",
        availability: "Available"
    });

    const [message, setMessage] = useState<{ type: 'success' | 'error', text: string } | null>(null);
    const [loading, setLoading] = useState(false);

    const resourceTypes = [
        'Personnel',
        'Equipment',
        'Location',
        'Wardrobe',
        'Props',
        'Set Decoration',
        'Vehicles',
        'Catering',
        'Supplies',
        'Miscellaneous'
    ];

    const availabilityOptions: Resource['availability'][] = [
        'Available',
        'Unavailable',
        'In Use',
        'Maintenance',
        'Booked',
        'Needs Repair'
    ];

    // New: Options for the Resource Name dropdown
    const resourceNameOptions: Resource['name'][] = [
        'Red Dress',
        'Wooden Staff',
        'Arri Camera',
        'Boom Mic',
        'Tripod',
        'Catering Van',
        'Actor Trailer',
        'Lunch for 50',
        'Sound Mixer',
        'Lighting Kit',
        'Clapperboard',
        'Makeup Kit'
        // Add more specific resource names here as needed
    ];

    const handleInputChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>) => {
        const { name, value } = e.target;

        // Type assertion for 'name', 'type', and 'availability' fields
        if (name === "name") {
            setNewResource({
                ...newResource,
                name: value as Resource['name']
            });
        } else if (name === "type") {
            setNewResource({
                ...newResource,
                type: value as Resource['type']
            });
        } else if (name === "availability") {
            setNewResource({
                ...newResource,
                availability: value as Resource['availability']
            });
        }
        setMessage(null);
    };

    const handleAddResource = async () => {
        // Validation now checks for selected options (which are always non-empty if required)
        if (!newResource.name || !newResource.type || !newResource.availability) {
            setMessage({ type: 'error', text: 'Please select all fields.' });
            return;
        }

        setLoading(true);
        setMessage(null);

        try {
            // const createdResource = await createResource(newResource);
            // setResources(prevResources => [...prevResources, createdResource]);

            const resourceToAdd: Resource = { ...newResource };
            setResources(prevResources => [...prevResources, resourceToAdd]);
            setMessage({ type: 'success', text: 'Resource added successfully!' });

            setNewResource({
                name: resourceNameOptions[0], // Reset to first option or a meaningful default
                type: "Equipment",
                availability: "Available"
            });

            setTimeout(() => setMessage(null), 3000);

        } catch (error: any) {
            setMessage({ type: 'error', text: error.message || 'Failed to add resource.' });
            console.error("Error adding resource:", error);
        } finally {
            setLoading(false);
        }
    };

    return (
        <div className="glass-card resource-management-container">
            <h2>Resource Management</h2>

            {message && (
                <div className={`message ${message.type}`}>
                    {message.text}
                </div>
            )}

            {/* MODIFIED: Resource Name as a dropdown */}
            <div className="form-group">
                <label htmlFor="resourceName">Resource Name:</label>
                <select
                    id="resourceName"
                    name="name"
                    value={newResource.name}
                    onChange={handleInputChange}
                    className="form-control"
                    required
                >
                    <option value="" disabled>-- Select a resource name --</option> {/* Optional: A disabled default */}
                    {resourceNameOptions.map(option => (
                        <option key={option} value={option}>
                            {option}
                        </option>
                    ))}
                </select>
            </div>

            <div className="form-group">
                <label htmlFor="resourceType">Resource Type/Category:</label>
                <select
                    id="resourceType"
                    name="type"
                    value={newResource.type}
                    onChange={handleInputChange}
                    className="form-control"
                    required
                >
                    <option value="" disabled>-- Select a category --</option>
                    {resourceTypes.map(typeOption => (
                        <option key={typeOption} value={typeOption}>
                            {typeOption}
                        </option>
                    ))}
                </select>
            </div>

            <div className="form-group">
                <label htmlFor="resourceAvailability">Availability Status:</label>
                <select
                    id="resourceAvailability"
                    name="availability"
                    value={newResource.availability}
                    onChange={handleInputChange}
                    className="form-control"
                    required
                >
                    {/* <option value="" disabled>-- Select status --</option> */}
                    {availabilityOptions.map(option => (
                        <option key={option} value={option}>
                            {option}
                        </option>
                    ))}
                </select>
            </div>

            <button onClick={handleAddResource} className="add-resource-button" disabled={loading}>
                {loading ? 'Adding...' : 'Add Resource'}
            </button>

            <div className="resources-list">
                <h3>Current Resources</h3>
                {resources.length === 0 ? (
                    <p>No resources added yet.</p>
                ) : (
                    <ul>
                        {resources.map((resource, index) => (
                            <li key={index}>
                                <strong>{resource.name}</strong> (Type: {resource.type}) - Availability: {resource.availability}
                            </li>
                        ))}
                    </ul>
                )}
            </div>
        </div>
    );
};

export default ResourceManagement;
