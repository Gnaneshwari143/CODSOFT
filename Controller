import React, { useState } from 'react';
import { createResource } from '../api/resource'; // Import the createResource function

// Assuming your Resource interface is defined in src/interfaces/Resource.ts
// It's crucial that this interface includes the '' (empty string) as a valid type
// for 'name' and 'type' to handle the default placeholder options.
import { Resource } from '../interfaces/Resource';

const ResourceManagement: React.FC = () => {
    const [resources, setResources] = useState<Resource[]>([]);
    const [newResource, setNewResource] = useState<Resource>({
        name: "", // Initial state is empty string for the 'Resource Name' placeholder
        type: "", // Initial state is empty string for the 'Resource Type/Category' placeholder
        availability: "Available" // You can set this to "" if you want a placeholder for Availability too
    });

    const [message, setMessage] = useState<{ type: 'success' | 'error', text: string } | null>(null);
    const [loading, setLoading] = useState(false);

    // Options for the Resource Type/Category dropdown (broader categories)
    const resourceTypes: Resource['type'][] = [
        'Personnel',       // For Cast, Crew, etc.
        'Equipment',       // For Cameras, Lights, Sound Gear, etc.
        'Location',        // For specific shooting locations
        'Wardrobe',        // For Costumes, clothing items
        'Props',           // For specific props
        'Set Decoration',  // For furniture, decor, etc.
        'Vehicles',        // For Cars, Trucks, Caravans, etc.
        'Catering',        // For Food, drinks
        'Supplies',        // For office supplies, cleaning supplies, etc.
        'Miscellaneous'    // For anything else
    ];

    // Options for the Availability dropdown
    const availabilityOptions: Resource['availability'][] = [
        'Available',
        'Unavailable',
        'In Use',
        'Maintenance',
        'Booked',
        'Needs Repair'
    ];

    // Options for the Resource Name dropdown (specific resource examples)
    const resourceNameOptions: Resource['name'][] = [
        'Red Dress',
        'Wooden Staff',
        'Arri Camera',
        'Boom Mic',
        'Tripod',
        'Catering Van',
        'Actor Trailer',
        'Lunch for 50',
        'Sound Mixer',
        'Lighting Kit',
        'Clapperboard',
        'Makeup Kit'
        // Add more specific resource names here as needed
    ];

    const handleInputChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
        const { name, value } = e.target;

        // Type assertion for 'name', 'type', and 'availability' fields to match their specific string literal types
        if (name === "name") {
            setNewResource({
                ...newResource,
                name: value as Resource['name']
            });
        } else if (name === "type") {
            setNewResource({
                ...newResource,
                type: value as Resource['type']
            });
        } else if (name === "availability") {
            setNewResource({
                ...newResource,
                availability: value as Resource['availability']
            });
        }
        setMessage(null); // Clear messages when user interacts
    };

    const handleAddResource = async () => {
        // Validation: Check if default empty string placeholders are still selected
        if (!newResource.name || !newResource.type || !newResource.availability) {
            setMessage({ type: 'error', text: 'Please select an option for all fields.' });
            return;
        }

        setLoading(true); // Indicate loading
        setMessage(null); // Clear previous messages

        try {
            // Call the backend API to create the resource
            // The createdResource might contain an 'id' returned by the backend
            const createdResource = await createResource(newResource); // Send newResource to backend

            // Update local state with the resource returned by the backend (e.g., with ID)
            setResources(prevResources => [...prevResources, createdResource]);
            setMessage({ type: 'success', text: 'Resource added successfully!' });

            // Reset the form to show default placeholder options
            setNewResource({
                name: "", // Reset to empty string to show placeholder
                type: "", // Reset to empty string to show placeholder
                availability: "Available" // Resets to 'Available' or set to "" for a placeholder
            });

            // Optional: Hide success message after a few seconds
            setTimeout(() => setMessage(null), 3000);

        } catch (error: any) {
            // Handle API errors
            setMessage({ type: 'error', text: error.message || 'Failed to add resource.' });
            console.error("Error adding resource:", error);
        } finally {
            setLoading(false); // End loading
        }
    };

    return (
        <div className="glass-card resource-management-container">
            <h2>Resource Management</h2>

            {/* Message Display (Success/Error) */}
            {message && (
                <div className={`message ${message.type}`}>
                    {message.text}
                </div>
            )}

            {/* Resource Name Dropdown */}
            <div className="form-group">
                <label htmlFor="resourceName">Resource Name:</label>
                <select
                    id="resourceName"
                    name="name"
                    value={newResource.name}
                    onChange={handleInputChange}
                    className="form-control"
                    required // HTML5 validation: requires a selection other than the default empty
                >
                    {/* Default placeholder option */}
                    <option value="" disabled hidden>-- Select a resource name --</option>
                    {resourceNameOptions.map(option => (
                        <option key={option} value={option}>
                            {option}
                        </option>
                    ))}
                </select>
            </div>

            {/* Resource Type/Category Dropdown */}
            <div className="form-group">
                <label htmlFor="resourceType">Resource Type/Category:</label>
                <select
                    id="resourceType"
                    name="type"
                    value={newResource.type}
                    onChange={handleInputChange}
                    className="form-control"
                    required
                >
                    {/* Default placeholder option */}
                    <option value="" disabled hidden>-- Select a category --</option>
                    {resourceTypes.map(typeOption => (
                        <option key={typeOption} value={typeOption}>
                            {typeOption}
                        </option>
                    ))}
                </select>
            </div>

            {/* Availability Status Dropdown */}
            <div className="form-group">
                <label htmlFor="resourceAvailability">Availability Status:</label>
                <select
                    id="resourceAvailability"
                    name="availability"
                    value={newResource.availability}
                    onChange={handleInputChange}
                    className="form-control"
                    required
                >
                    {/* If you wanted a placeholder here instead of 'Available' as default: */}
                    {/* <option value="" disabled hidden>-- Select status --</option> */}
                    {availabilityOptions.map(option => (
                        <option key={option} value={option}>
                            {option}
                        </option>
                    ))}
                </select>
            </div>

            {/* Add Resource Button */}
            <button onClick={handleAddResource} className="add-resource-button" disabled={loading}>
                {loading ? 'Adding...' : 'Add Resource'}
            </button>

            {/* Displaying Current Resources (fetched from local state after adding) */}
            <div className="resources-list">
                <h3>Current Resources</h3>
                {resources.length === 0 ? (
                    <p>No resources added yet (only locally for demonstration).</p>
                ) : (
                    <ul>
                        {resources.map((resource, index) => (
                            // Using index as key is okay for static lists, but resource.id from backend is better
                            <li key={resource.id || index}>
                                <strong>{resource.name}</strong> (Type: {resource.type}) - Availability: {resource.availability}
                            </li>
                        ))}
                    </ul>
                )}
            </div>
        </div>
    );
};

export default ResourceManagement;
