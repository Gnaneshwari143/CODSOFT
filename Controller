// You MUST have this injected for the methods below to work
    @Autowired
    private ScriptsRepository scriptsRepository; 

    /**
     * Retrieves all script breakdown items from the database.
     * Converts entities to DTOs using the helper method.
     */
    public List<ScriptsDTO> getAllScripts() {
        return scriptsRepository.findAll().stream()
                .map(this::convertToScriptsDTO) // Use the new helper method for Scripts
                .collect(Collectors.toList());
    }

    /**
     * Retrieves a single script breakdown item by its ID.
     * Throws MovieProductionException if the script is not found.
     */
    public ScriptsDTO getScriptById(Long id) throws MovieProductionException {
        Scripts script = scriptsRepository.findById(id)
                .orElseThrow(() -> new MovieProductionException("Script not found with ID: " + id));
        return convertToScriptsDTO(script);
    }

    /**
     * Helper method to convert a Scripts entity to a ScriptsDTO.
     * Handles conversion of comma-separated String (Entity) to List<String> (DTO).
     * This method is essential because your Scripts entity stores characters/equipment as String,
     * while your ScriptsDTO uses List<String>.
     */
    private ScriptsDTO convertToScriptsDTO(Scripts script) {
        ScriptsDTO dto = new ScriptsDTO();
        dto.setId(script.getId());
        dto.setScriptNumber(script.getScriptNumber());
        dto.setDescription(script.getDescription());

        // Convert comma-separated String from Entity to List<String> for DTO
        if (script.getCharacters() != null && !script.getCharacters().trim().isEmpty()) {
            dto.setCharacters(Arrays.asList(script.getCharacters().split(","))
                                    .stream().map(String::trim).collect(Collectors.toList()));
        } else {
            dto.setCharacters(List.of()); // Return an empty list for null/empty string
        }

        dto.setLocation(script.getLocation());

        // Convert comma-separated String from Entity to List<String> for DTO
        if (script.getEquipment() != null && !script.getEquipment().trim().isEmpty()) {
            dto.setEquipment(Arrays.asList(script.getEquipment().split(","))
                                   .stream().map(String::trim).collect(Collectors.toList()));
        } else {
            dto.setEquipment(List.of()); // Return an empty list for null/empty string
        }

        dto.setNotes(script.getNotes());
        return dto;
    }
