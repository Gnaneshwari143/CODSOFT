// src/components/ScriptBreakdown.tsx
import React, { useState, useEffect } from 'react';

// Define the interface for a Script Breakdown Item, matching your ScriptsDTO structure
interface ScriptItem {
    id?: number; // Optional, as it's generated by the backend for existing items
    scriptNumber: number;
    description: string;
    characters: string[]; // Matches List<String> in ScriptsDTO
    location: string;
    equipment: string[]; // Matches List<String> in ScriptsDTO
    notes: string;
}

const ScriptBreakdown: React.FC = () => {
    // State to hold the list of all script items fetched from/added to backend
    // This will display the items in the "Current Breakdown Items" section
    const [scriptItems, setScriptItems] = useState<ScriptItem[]>([]);

    // State to hold the data for the new script item being added through the form
    const [newScriptItem, setNewScriptItem] = useState<ScriptItem>({
        scriptNumber: 0, // Initialize as 0; will be validated to be > 0
        description: "",
        characters: [],
        location: "",
        equipment: [],
        notes: ""
    });

    // State for displaying messages (success or error) to the user
    const [message, setMessage] = useState<{ type: 'success' | 'error', text: string } | null>(null);
    // State for managing loading status during API calls
    const [loading, setLoading] = useState(false);

    // useEffect to fetch existing script items when the component mounts
    // This ensures that when the page loads, it displays any scripts already in the database
    useEffect(() => {
        const fetchScripts = async () => {
            setLoading(true);
            try {
                // Ensure this URL matches your backend's ScriptController @RequestMapping("/api/scripts")
                const response = await fetch('http://localhost:8080/api/scripts'); 
                if (!response.ok) {
                    throw new Error('Failed to fetch scripts');
                }
                const data: ScriptItem[] = await response.json();
                setScriptItems(data);
            } catch (error: any) {
                console.error("Error fetching scripts:", error);
                setMessage({ type: 'error', text: error.message || 'Failed to load existing scripts.' });
            } finally {
                setLoading(false);
            }
        };

        fetchScripts();
    }, []); // Empty dependency array means this runs once on component mount

    /**
     * Handles changes for standard text and number input fields.
     * @param e The change event from the input element.
     */
    const handleInputChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {
        const { name, value } = e.target;
        
        let processedValue: string | number = value;
        if (name === 'scriptNumber') {
            // Convert to number; if empty, treat as 0 for validation purposes
            processedValue = value === '' ? 0 : parseInt(value);
        }

        setNewScriptItem(prev => ({
            ...prev,
            [name]: processedValue
        }));
        setMessage(null); // Clear any previous messages on input change
    };

    /**
     * Handles changes for fields that store comma-separated values in the input but are arrays in state/DTO.
     * For example, "John, Jane" from input becomes ["John", "Jane"] in the state.
     * @param e The change event from the input element.
     * @param field The name of the array field ('characters' or 'equipment').
     */
    const handleArrayChange = (e: React.ChangeEvent<HTMLInputElement>, field: 'characters' | 'equipment') => {
        const { value } = e.target;
        // Split by comma, trim whitespace from each item, and filter out any empty strings
        const arrayValue = value.split(',').map(item => item.trim()).filter(item => item !== '');
        setNewScriptItem(prev => ({
            ...prev,
            [field]: arrayValue
        }));
        setMessage(null); // Clear messages on input change
    };

    /**
     * Handles the addition of a new script breakdown item.
     * Performs client-side validation and then sends data to the backend API.
     */
    const handleAddScene = async () => {
        setMessage(null); // Clear any previous messages before starting new validation/API call

        // --- START: Client-side Validation Checks (important for user experience) ---
        if (newScriptItem.scriptNumber <= 0 || isNaN(newScriptItem.scriptNumber)) {
            setMessage({ type: 'error', text: 'Script Number must be a valid number greater than 0.' });
            return;
        }
        if (!newScriptItem.description.trim()) {
            setMessage({ type: 'error', text: 'Description is required.' });
            return;
        }
        if (!newScriptItem.location.trim()) {
            setMessage({ type: 'error', text: 'Location is required.' });
            return;
        }
        // You can add more specific validations here (e.g., min/max length, regex patterns)
        // --- END: Client-side Validation Checks ---

        setLoading(true); // Indicate that an operation is in progress

        try {
            // Send the newScriptItem data to your Spring Boot backend's /api/scripts endpoint
            // The JSON.stringify(newScriptItem) converts the React state object
            // (which matches the ScriptItem interface/ScriptsDTO) into a JSON string
            const response = await fetch('http://localhost:8080/api/scripts', { // Make sure this URL is correct
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    // If you have authentication/authorization (e.g., JWT), add your token here:
                    // 'Authorization': `Bearer ${yourAuthToken}`,
                },
                body: JSON.stringify(newScriptItem), 
            });

            if (!response.ok) {
                // If the response status is not in the 2xx range, throw an error
                // Attempt to parse a specific error message from backend response body
                const errorData = await response.json();
                throw new Error(errorData.message || 'Failed to add script breakdown item.');
            }

            // If successful, the backend typically returns the created resource (ScriptsDTO in this case)
            const createdItem: ScriptItem = await response.json();
            // Add the newly created item (which now has an 'id' from the backend) to the list
            setScriptItems(prev => [...prev, createdItem]); 

            setMessage({ type: 'success', text: 'Script breakdown item added successfully!' });
            // Reset the form fields after successful addition
            setNewScriptItem({
                scriptNumber: 0, // Reset to 0 for the placeholder to show again
                description: "",
                characters: [],
                location: "",
                equipment: [],
                notes: ""
            });
            // Auto-hide success message after a few seconds for better user experience
            setTimeout(() => setMessage(null), 3000); 

        } catch (error: any) {
            // Catch and display any errors that occurred during the fetch operation or from backend response
            setMessage({ type: 'error', text: error.message || 'Failed to add script breakdown item. Please try again.' });
            console.error("Error adding script breakdown item:", error);
        } finally {
            setLoading(false); // End loading state, regardless of success or failure
        }
    };

    return (
        <div className="glass-card script-breakdown-container">
            <h2>Script Breakdown</h2>

            {/* Message Display Area (for success or error messages) */}
            {message && (
                <div className={`message ${message.type}`}>
                    {message.text}
                </div>
            )}

            {/* Input Form for creating a new script item */}
            <div className="form-group">
                <label htmlFor="scriptNumber">Script Number / ID:</label>
                <input
                    type="number"
                    id="scriptNumber"
                    name="scriptNumber"
                    value={newScriptItem.scriptNumber === 0 ? '' : newScriptItem.scriptNumber} // Display empty if 0, otherwise the number
                    onChange={handleInputChange}
                    className="form-control"
                    placeholder="e.g., 10"
                    required
                />
            </div>
            <div className="form-group">
                <label htmlFor="description">Description:</label>
                <textarea
                    id="description"
                    name="description"
                    value={newScriptItem.description}
                    onChange={handleInputChange}
                    className="form-control"
                    placeholder="e.g., Exterior day - John and Jane discuss their plans."
                    rows={3} // Provide some height for better user experience
                    required
                ></textarea>
            </div>

            <div className="form-row"> {/* Using form-row for a two-column layout using CSS flexbox */}
                <div className="form-group">
                    <label htmlFor="characters">Characters (comma separated):</label>
                    <input
                        type="text"
                        id="characters"
                        name="characters"
                        value={newScriptItem.characters.join(', ')} // Display array as comma-separated string for editing
                        onChange={(e) => handleArrayChange(e, 'characters')}
                        className="form-control"
                        placeholder="e.g., John, Jane, Extra #1"
                    />
                </div>
                <div className="form-group">
                    <label htmlFor="location">Location:</label>
                    <input
                        type="text"
                        id="location"
                        name="location"
                        value={newScriptItem.location}
                        onChange={handleInputChange}
                        className="form-control"
                        placeholder="e.g., Old Bridge, City Park"
                        required
                    />
                </div>
            </div>

            <div className="form-row"> {/* Another form-row for Equipment and Notes */}
                <div className="form-group">
                    <label htmlFor="equipment">Equipment (comma separated):</label>
                    <input
                        type="text"
                        id="equipment"
                        name="equipment"
                        value={newScriptItem.equipment.join(', ')} // Display array as comma-separated string for editing
                        onChange={(e) => handleArrayChange(e, 'equipment')}
                        className="form-control"
                        placeholder="e.g., Dolly, Steadicam, Boom Mic"
                    />
                </div>
                <div className="form-group">
                    <label htmlFor="notes">Notes:</label>
                    <textarea
                        id="notes"
                        name="notes"
                        value={newScriptItem.notes}
                        onChange={handleInputChange}
                        className="form-control"
                        placeholder="e.g., Needs green screen for background. Special effects needed."
                        rows={3}
                    ></textarea>
                </div>
            </div>

            <button onClick={handleAddScene} className="add-scene-button" disabled={loading}>
                {loading ? 'Adding...' : 'Add Scene'}
            </button>

            {/* Display List of Added/Fetched Script Items */}
            <div className="script-items-list">
                <h3>Current Breakdown Items</h3>
                {loading && scriptItems.length === 0 ? (
                    <p>Loading scripts...</p> // Show loading message if data is being fetched and list is empty
                ) : scriptItems.length === 0 ? (
                    <p>No script breakdown items added yet.</p> // Message if no items
                ) : (
                    <ul>
                        {scriptItems.map((item) => (
                            // Using item.id as the key is best practice if available (backend generated ID)
                            // Fallback to scriptNumber if id isn't available, or index as a last resort
                            <li key={item.id || item.scriptNumber}> 
                                <strong>Scene {item.scriptNumber}:</strong> {item.description}<br/>
                                <strong>Characters:</strong> {item.characters.join(', ') || 'N/A'}<br/>
                                <strong>Location:</strong> {item.location}<br/>
                                <strong>Equipment:</strong> {item.equipment.join(', ') || 'N/A'}<br/>
                                <strong>Notes:</strong> {item.notes || 'N/A'}
                            </li>
                        ))}
                    </ul>
                )}
            </div>
        </div>
    );
};

export default ScriptBreakdown;
