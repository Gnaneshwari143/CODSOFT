import React, { useState } from 'react';
// Assuming createResource exists in your api/resource.ts or similar file
// import { createResource } from '../api/resource'; // Uncomment when ready to connect to backend

interface Resource {
    name: string; // This will now hold specific items like "Red Dress", "Wooden Staff", "Catering Van"
    type: 'Personnel' | 'Equipment' | 'Location' | 'Wardrobe' | 'Props' | 'Set Decoration' | 'Vehicles' | 'Catering' | 'Supplies' | 'Miscellaneous'; // Broader categories for the dropdown
    availability: string;
    // id?: number; // Optional: if your backend assigns an ID
}

const ResourceManagement: React.FC = () => {
    // State to hold all managed resources (if you fetch and display them)
    const [resources, setResources] = useState<Resource[]>([]);

    // State for the new resource being added via the form
    const [newResource, setNewResource] = useState<Resource>({
        name: "",
        type: "Equipment", // Default broad category
        availability: ""
    });

    // State for messages (success/error)
    const [message, setMessage] = useState<{ type: 'success' | 'error', text: string } | null>(null);
    const [loading, setLoading] = useState(false); // To disable button during API call

    // Options for the dropdown menu (broader categories)
    const resourceTypes = [
        'Personnel',       // For Cast, Crew, etc.
        'Equipment',       // For Cameras, Lights, Sound Gear, etc.
        'Location',        // For specific shooting locations
        'Wardrobe',        // For Costumes, clothing items
        'Props',           // For specific props
        'Set Decoration',  // For furniture, decor, etc.
        'Vehicles',        // For Cars, Trucks, Caravans, etc.
        'Catering',        // For Food, drinks
        'Supplies',        // For office supplies, cleaning supplies, etc.
        'Miscellaneous'    // For anything else
    ];

    const handleInputChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>) => {
        const { name, value } = e.target;
        setNewResource({
            ...newResource,
            [name]: value
        });
        setMessage(null); // Clear messages when user types
    };

    const handleAddResource = async () => {
        // Basic validation
        if (!newResource.name.trim() || !newResource.type || !newResource.availability.trim()) {
            setMessage({ type: 'error', text: 'Please fill all fields.' });
            return;
        }

        setLoading(true); // Start loading
        setMessage(null); // Clear previous messages

        try {
            // In a real application, you would send this to your backend API
            // Example:
            // const createdResource = await createResource(newResource);
            // setResources(prevResources => [...prevResources, createdResource]);

            // For now, simulating adding to local state:
            const resourceToAdd: Resource = { ...newResource, name: newResource.name.trim(), availability: newResource.availability.trim() };
            setResources(prevResources => [...prevResources, resourceToAdd]);
            setMessage({ type: 'success', text: 'Resource added successfully!' });

            // Reset the form
            setNewResource({
                name: "",
                type: "Equipment", // Reset to default type
                availability: ""
            });

            // Optional: Hide success message after a few seconds
            setTimeout(() => setMessage(null), 3000);

        } catch (error: any) {
            // Handle API errors
            setMessage({ type: 'error', text: error.message || 'Failed to add resource.' });
            console.error("Error adding resource:", error);
        } finally {
            setLoading(false); // End loading
        }
    };

    return (
        <div className="glass-card resource-management-container">
            <h2>Resource Management</h2>

            {/* Message Display */}
            {message && (
                <div className={`message ${message.type}`}>
                    {message.text}
                </div>
            )}

            <div className="form-group">
                <label htmlFor="resourceName">Resource Name/Description:</label>
                <input
                    type="text"
                    id="resourceName"
                    name="name"
                    placeholder="e.g., Red Dress for Lead, Wooden Staff, Catering Van"
                    value={newResource.name}
                    onChange={handleInputChange}
                    className="form-control"
                    required // Added required attribute
                />
            </div>

            <div className="form-group">
                <label htmlFor="resourceType">Resource Type/Category:</label>
                <select
                    id="resourceType"
                    name="type"
                    value={newResource.type}
                    onChange={handleInputChange}
                    className="form-control"
                    required // Added required attribute
                >
                    <option value="" disabled>-- Select a category --</option>
                    {resourceTypes.map(typeOption => (
                        <option key={typeOption} value={typeOption}>
                            {typeOption}
                        </option>
                    ))}
                </select>
            </div>

            <div className="form-group">
                <label htmlFor="resourceAvailability">Availability:</label>
                <input
                    type="text"
                    id="resourceAvailability"
                    name="availability"
                    placeholder="e.g., Available 24/7, M-F 9am-5pm, Needs Repair"
                    value={newResource.availability}
                    onChange={handleInputChange}
                    className="form-control"
                    required // Added required attribute
                />
            </div>

            <button onClick={handleAddResource} className="add-resource-button" disabled={loading}>
                {loading ? 'Adding...' : 'Add Resource'}
            </button>

            {/* Displaying existing resources */}
            <div className="resources-list">
                <h3>Current Resources</h3>
                {resources.length === 0 ? (
                    <p>No resources added yet.</p>
                ) : (
                    <ul>
                        {resources.map((resource, index) => (
                            <li key={index}>
                                <strong>{resource.name}</strong> (Type: {resource.type}) - Availability: {resource.availability}
                            </li>
                        ))}
                    </ul>
                )}
            </div>
        </div>
    );
};

export default ResourceManagement;
