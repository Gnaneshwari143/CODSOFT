import React, { useState } from 'react';
// import { createSchedule, fetchSchedules } from '../api/schedule'; // Uncomment when backend is ready

interface ScheduleItem {
    movieId: string;
    sceneNumber: number;
    date: string; // YYYY-MM-DD
    time: string; // HH:MM
    location: string;
    cast: string[]; // Array of cast IDs/names
    crew: string[]; // Array of crew IDs/names
    notes: string;
    // id?: number; // Add if backend assigns ID
}

const ShootingSchedule: React.FC = () => {
    const [schedules, setSchedules] = useState<ScheduleItem[]>([]);
    const [newSchedule, setNewSchedule] = useState<ScheduleItem>({
        movieId: "",
        sceneNumber: 0, // Initialize as 0 to differentiate from valid empty input later
        date: "",
        time: "",
        location: "",
        cast: [],
        crew: [],
        notes: ""
    });

    const [message, setMessage] = useState<{ type: 'success' | 'error', text: string } | null>(null);
    const [loading, setLoading] = useState(false);

    const handleInputChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {
        const { name, value } = e.target;
        
        let processedValue: string | number | string[] = value;

        if (name === 'sceneNumber') {
            processedValue = value === '' ? 0 : parseInt(value); // Convert to 0 if empty for state, so 'required' works well
        } else if (name === 'cast' || name === 'crew') {
            // This is now handled by handleArrayChange, but keeping general logic for future reference
            // For now, these direct inputs are handled by handleArrayChange below.
            // If you used a single handleInputChange for all, this would be `value.split(',').map(item => item.trim()).filter(item => item !== '')`
        }

        setNewSchedule(prev => ({
            ...prev,
            [name]: processedValue
        }));
        setMessage(null); // Clear messages when user types
    };

    const handleArrayChange = (e: React.ChangeEvent<HTMLInputElement>, field: 'cast' | 'crew') => {
        const { value } = e.target;
        setNewSchedule(prev => ({
            ...prev,
            [field]: value.split(',').map(item => item.trim()).filter(item => item !== '')
        }));
        setMessage(null); // Clear messages when user types
    };

    const handleAddSchedule = async () => {
        setMessage(null); // Clear any previous messages

        // --- START: Enhanced Validation Checks ---
        if (!newSchedule.movieId.trim()) {
            setMessage({ type: 'error', text: 'Please enter a valid Movie ID.' });
            return;
        }
        if (newSchedule.sceneNumber <= 0 || isNaN(newSchedule.sceneNumber)) {
            setMessage({ type: 'error', text: 'Please enter a valid Scene Number (must be greater than 0).' });
            return;
        }
        if (!newSchedule.date) {
            setMessage({ type: 'error', text: 'Please select a Date for the schedule item.' });
            return;
        }
        if (!newSchedule.time) {
            setMessage({ type: 'error', text: 'Please select a Time for the schedule item.' });
            return;
        }
        if (!newSchedule.location.trim()) {
            setMessage({ type: 'error', text: 'Please enter a valid Location.' });
            return;
        }
        // Cast and Crew are optional, but you could add checks like:
        // if (newSchedule.cast.length === 0) { /* message */ }
        // if (newSchedule.crew.length === 0) { /* message */ }
        // --- END: Enhanced Validation Checks ---

        setLoading(true);
        try {
            // const createdSchedule = await createSchedule(newSchedule); // Uncomment for backend
            // setSchedules(prev => [...prev, createdSchedule]); // Uncomment for backend

            // For now, local state update:
            setSchedules(prev => [...prev, { ...newSchedule }]);

            setMessage({ type: 'success', text: 'Schedule item added successfully!' });
            // Reset the form after successful addition
            setNewSchedule({
                movieId: "",
                sceneNumber: 0,
                date: "",
                time: "",
                location: "",
                cast: [],
                crew: [],
                notes: ""
            });
            setTimeout(() => setMessage(null), 3000); // Hide success message after 3 seconds
        } catch (error: any) {
            setMessage({ type: 'error', text: error.message || 'Failed to add schedule item. Please try again.' });
            console.error("Error adding schedule item:", error);
        } finally {
            setLoading(false);
        }
    };

    // useEffect(() => { // Uncomment to fetch schedules on component mount
    //     const getSchedules = async () => {
    //         setLoading(true);
    //         try {
    //             const data = await fetchSchedules();
    //             setSchedules(data);
    //         } catch (err: any) {
    //             console.error("Error fetching schedules:", err);
    //         } finally {
    //             setLoading(false);
    //         }
    //     };
    //     getSchedules();
    // }, []);

    return (
        <div className="glass-card schedule-management-container">
            <h2>Shooting Schedule Management</h2>

            {message && (
                <div className={`message ${message.type}`}>
                    {message.text}
                </div>
            )}

            <div className="form-group">
                <label htmlFor="movieId">Movie ID:</label>
                <input type="text" id="movieId" name="movieId" value={newSchedule.movieId} onChange={handleInputChange} className="form-control" placeholder="e.g., PROD001" required />
            </div>
            <div className="form-group">
                <label htmlFor="sceneNumber">Scene Number:</label>
                {/* Display empty string if 0 for better UX, otherwise actual number */}
                <input type="number" id="sceneNumber" name="sceneNumber" value={newSchedule.sceneNumber === 0 ? '' : newSchedule.sceneNumber} onChange={handleInputChange} className="form-control" placeholder="e.g., 1, 2.5" required />
            </div>
            <div className="form-group">
                <label htmlFor="date">Date:</label>
                <input type="date" id="date" name="date" value={newSchedule.date} onChange={handleInputChange} className="form-control" required />
            </div>
            <div className="form-group">
                <label htmlFor="time">Time:</label>
                <input type="time" id="time" name="time" value={newSchedule.time} onChange={handleInputChange} className="form-control" required />
            </div>
            <div className="form-group">
                <label htmlFor="location">Location:</label>
                <input type="text" id="location" name="location" value={newSchedule.location} onChange={handleInputChange} className="form-control" placeholder="e.g., Park Street, Studio A" required />
            </div>
            <div className="form-group">
                <label htmlFor="cast">Cast (comma separated):</label>
                <input type="text" id="cast" name="cast" value={newSchedule.cast.join(', ')} onChange={(e) => handleArrayChange(e, 'cast')} className="form-control" placeholder="e.g., John Doe, Jane Smith" />
            </div>
            <div className="form-group">
                <label htmlFor="crew">Crew (comma separated):</label>
                <input type="text" id="crew" name="crew" value={newSchedule.crew.join(', ')} onChange={(e) => handleArrayChange(e, 'crew')} className="form-control" placeholder="e.g., Director, DP, Sound Mixer" />
            </div>
            <div className="form-group">
                <label htmlFor="notes">Notes:</label>
                <textarea id="notes" name="notes" value={newSchedule.notes} onChange={handleInputChange} className="form-control" placeholder="e.g., Exterior day, dialogue heavy"></textarea>
            </div>

            <button onClick={handleAddSchedule} className="add-schedule-button" disabled={loading}>
                {loading ? 'Adding...' : 'Add Schedule Item'}
            </button>

            <div className="schedules-list">
                <h3>Current Schedule Items</h3>
                {schedules.length === 0 ? (
                    <p>No schedule items added yet.</p>
                ) : (
                    <ul>
                        {schedules.map((item, index) => (
                            <li key={item.movieId + item.sceneNumber + index}>
                                <strong>Movie: {item.movieId} | Scene: {item.sceneNumber}</strong><br/>
                                Date: {item.date} at {item.time}<br/>
                                Location: {item.location}<br/>
                                Cast: {item.cast.join(', ')}<br/>
                                Crew: {item.crew.join(', ')}<br/>
                                Notes: {item.notes}
                            </li>
                        ))}
                    </ul>
                )}
            </div>
        </div>
    );
};

export default ShootingSchedule;
