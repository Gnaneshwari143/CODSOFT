@RestController
@RequestMapping("/api")
@RequiredArgsConstructor
public class AssistantDirectorController {
    private final AssistantDirectorService service;

    // ======================= Schedule Endpoints =======================
    @PostMapping("/schedules")
    public ResponseEntity<ScheduleDTO> createSchedule(@Valid @RequestBody ScheduleDTO scheduleDTO) 
        throws MovieProductionException {
        return new ResponseEntity<>(service.createSchedule(scheduleDTO), HttpStatus.CREATED);
    }

    @PutMapping("/schedules/{id}")
    public ResponseEntity<ScheduleDTO> updateSchedule(
            @PathVariable Integer id,
            @Valid @RequestBody ScheduleDTO scheduleDTO) 
        throws MovieProductionException {
        return ResponseEntity.ok(service.updateSchedule(id, scheduleDTO));
    }

    @GetMapping("/schedules")
    public ResponseEntity<List<ScheduleDTO>> getAllSchedules() 
        throws MovieProductionException {
        return ResponseEntity.ok(service.getAllSchedules());
    }

    @GetMapping("/schedules/{id}")
    public ResponseEntity<ScheduleDTO> getScheduleById(@PathVariable Integer id) 
        throws MovieProductionException {
        return ResponseEntity.ok(service.getScheduleById(id));
    }

    @DeleteMapping("/schedules/{id}")
    public ResponseEntity<Void> deleteSchedule(@PathVariable Integer id) 
        throws MovieProductionException {
        service.deleteSchedule(id);
        return ResponseEntity.noContent().build();
    }

    // ======================= Script Endpoints =======================
    @PostMapping("/scripts")
    public ResponseEntity<ScriptsDTO> uploadScript(@Valid @RequestBody ScriptsDTO scriptsDTO) 
        throws MovieProductionException {
        return new ResponseEntity<>(service.uploadScript(scriptsDTO), HttpStatus.CREATED);
    }

    @PutMapping("/scripts/{id}/version")
    public ResponseEntity<ScriptsDTO> updateScriptVersion(
            @PathVariable Integer id,
            @RequestParam String newVersion) 
        throws MovieProductionException {
        return ResponseEntity.ok(service.updateScriptVersion(id, newVersion));
    }

    @PostMapping("/scripts/{id}/breakdown")
    public ResponseEntity<List<SceneBTO>> breakdownScript(
            @PathVariable Integer id,
            @Valid @RequestBody List<SceneBTO> sceneBTOs) 
        throws MovieProductionException {
        return new ResponseEntity<>(service.breakdownScripts(id, sceneBTOs), HttpStatus.CREATED);
    }

    // ======================= Call Sheet Endpoints =======================
    @PostMapping("/call-sheets")
    public ResponseEntity<CallSheetDTO> createCallSheet(@Valid @RequestBody CallSheetDTO callSheetDTO) 
        throws MovieProductionException {
        return new ResponseEntity<>(service.createdCallSheet(callSheetDTO), HttpStatus.CREATED);
    }

    @PutMapping("/call-sheets/{id}")
    public ResponseEntity<CallSheetDTO> updateCallSheet(
            @PathVariable Long id,
            @Valid @RequestBody CallSheetDTO callSheetDTO) 
        throws MovieProductionException {
        return ResponseEntity.ok(service.updatedAllSheet(id, callSheetDTO));
    }

    @GetMapping("/call-sheets")
    public ResponseEntity<List<CallSheetDTO>> getAllCallSheets() 
        throws MovieProductionException {
        return ResponseEntity.ok(service.getAllCallSheets());
    }

    @GetMapping("/call-sheets/{id}")
    public ResponseEntity<CallSheetDTO> getCallSheetById(@PathVariable Long id) 
        throws MovieProductionException {
        return ResponseEntity.ok(service.getCallSheetById(id));
    }

    @DeleteMapping("/call-sheets/{id}")
    public ResponseEntity<Void> deleteCallSheet(@PathVariable Long id) 
        throws MovieProductionException {
        service.deleteCallSheet(id);
        return ResponseEntity.noContent().build();
    }

    // ======================= Exception Handling =======================
    @ExceptionHandler(MovieProductionException.class)
    public ResponseEntity<String> handleMovieProductionException(MovieProductionException ex) {
        return new ResponseEntity<>(ex.getMessage(), HttpStatus.BAD_REQUEST);
    }
}
