/* src/App.css or src/styles/formLayout.css */

.form-row {
    display: flex; /* Enables flexbox */
    gap: 20px; /* Space between the elements */
    margin-bottom: 15px; /* Maintain vertical spacing for the row itself */
    flex-wrap: wrap; /* Allow wrapping on smaller screens */
    align-items: flex-start; /* Align items to the top */
}

.form-row .form-group {
    flex: 1; /* Allows each form-group to take up equal space */
    min-width: 150px; /* Ensures minimum width before wrapping */
    margin-bottom: 0; /* Remove default margin-bottom from form-group if it's inside a row */
}

/* Optional: Adjust for smaller screens if needed */
@media (max-width: 600px) {
    .form-row {
        flex-direction: column; /* Stack elements vertically on very small screens */
        gap: 0; /* Remove gap when stacked */
    }
    .form-row .form-group {
        width: 100%; /* Take full width when stacked */
        margin-bottom: 15px; /* Re-add margin for stacked items */
    }
}
