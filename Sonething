export interface Product {
  code: string;
  name: string;
  description?: string;
  price: number;
}

export interface CartItem {
  productCode: string;
  productName: string;
  description?: string;
  qty: number;
  pricePerUnit: number;
  linePrice: number; // qty * pricePerUnit
}





import { createSlice, PayloadAction } from '@reduxjs/toolkit';
import { CartItem, Product } from './types';

interface CartState {
  items: Record<string, CartItem>;
}

const initialState: CartState = { items: {} };

const cartSlice = createSlice({
  name: 'cart',
  initialState,
  reducers: {
    addProductToCart(state, action: PayloadAction<Product>) {
      const p = action.payload;
      const key = p.code;
      if (state.items[key]) {
        // increment
        const item = state.items[key];
        item.qty += 1;
        item.linePrice = Math.round(item.qty * item.pricePerUnit * 100) / 100;
      } else {
        state.items[key] = {
          productCode: p.code,
          productName: p.name,
          description: p.description,
          qty: 1,
          pricePerUnit: p.price,
          linePrice: Math.round(1 * p.price * 100) / 100
        };
      }
    },
    incrementQty(state, action: PayloadAction<{ productCode: string }>) {
      const key = action.payload.productCode;
      const item = state.items[key];
      if (item) {
        item.qty += 1;
        item.linePrice = Math.round(item.qty * item.pricePerUnit * 100) / 100;
      }
    },
    decrementQty(state, action: PayloadAction<{ productCode: string }>) {
      const key = action.payload.productCode;
      const item = state.items[key];
      if (item) {
        item.qty -= 1;
        if (item.qty <= 0) {
          delete state.items[key];
        } else {
          item.linePrice = Math.round(item.qty * item.pricePerUnit * 100) / 100;
        }
      }
    },
    setQty(state, action: PayloadAction<{ productCode: string; qty: number }>) {
      const { productCode, qty } = action.payload;
      const item = state.items[productCode];
      if (!item) return;
      if (qty <= 0) {
        delete state.items[productCode];
      } else {
        item.qty = Math.floor(qty);
        item.linePrice = Math.round(item.qty * item.pricePerUnit * 100) / 100;
      }
    },
    removeItem(state, action: PayloadAction<{ productCode: string }>) {
      delete state.items[action.payload.productCode];
    },
    clearCart(state) {
      state.items = {};
    }
  }
});

export const {
  addProductToCart,
  incrementQty,
  decrementQty,
  setQty,
  removeItem,
  clearCart
} = cartSlice.actions;

export default cartSlice.reducer;



