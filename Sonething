const ProductList: React.FC<{ products: Product[] }> = ({ products }) => {
  const dispatch = useDispatch();

  const onClickProduct = (p: Product) => {
    // dispatch action from the library
    dispatch(addProductToCart(p));
  };

  return (
    <div>
      {products.map(p => (
        <div key={p.code} className="product-item" onClick={() => onClickProduct(p)}>
          <div>
            <div style={{fontWeight:600}}>{p.code} — {p.name}</div>
            <div style={{fontSize:12, color:'#555'}}>{p.description}</div>
          </div>
          <div style={{textAlign:'right'}}>
            <div style={{fontWeight:700}}>₹{p.price.toFixed(2)}</div>
            <div style={{fontSize:12, color:'#888'}}>Click to add</div>
          </div>
        </div>
      ))}
    </div>
  );
};

