import React, { useMemo, useState } from 'react';
import { useSelector, useDispatch } from 'react-redux';
import { RootState, clearCart, removeItem, setQty } from '@local/redux-lib';
import CartItem from './CartItem';

export default function CartPane() {
  const itemsMap = useSelector((s: RootState) => s.cart.items);
  const dispatch = useDispatch();
  const [message, setMessage] = useState<{type:'success'|'error'; text:string} | null>(null);

  const items = Object.values(itemsMap);

  const total = useMemo(() => {
    return items.reduce((acc, it) => acc + it.linePrice, 0);
  }, [items]);

  const onClear = () => {
    dispatch(clearCart());
    setMessage({ type: 'success', text: 'Cart cleared' });
    setTimeout(()=>setMessage(null), 2000);
  };

  const onCheckout = async () => {
    if (items.length === 0) {
      setMessage({ type: 'error', text: 'Cart is empty' });
      setTimeout(()=>setMessage(null), 2000);
      return;
    }
    // Simulate save to server; replace URL with your backend endpoint
    try {
      const payload = {
        username: 'demo_user',
        totalPrice: total,
        items: items.map(it => ({
          productCode: it.productCode,
          productName: it.productName,
          qty: it.qty,
          pricePerUnit: it.pricePerUnit,
          linePrice: it.linePrice
        }))
      };

      // Example POST - change URL if you have backend
      const res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!res.ok) {
        // read body if available
        const err = await res.json().catch(()=>({message:'Unknown error'}));
        throw new Error(err.message || 'Failed to save cart');
      }

      // on success
      dispatch(clearCart());
      setMessage({ type: 'success', text: 'Checkout saved successfully' });
      setTimeout(()=>setMessage(null), 2000);
    } catch (err: any) {
      setMessage({ type: 'error', text: `Save failed: ${err.message}` });
      setTimeout(()=>setMessage(null), 3000);
    }
  };

  return (
    <div style={{display:'flex', flexDirection:'column', height:'100%'}}>
      <div className="cart-items">
        {message && <div className={`message ${message.type === 'success' ? 'success' : 'error'}`}>{message.text}</div>}
        {items.length === 0 ? (
          <div className="empty">Cart is empty. Click a product to add it.</div>
        ) : (
          items.map(it => (
            <CartItem key={it.productCode} item={it}
              onRemove={() => dispatch(removeItem({ productCode: it.productCode }))}
              onSetQty={(qty:number) => dispatch(setQty({ productCode: it.productCode, qty }))}
            />
          ))
        )}
      </div>

      <div className="cart-footer">
        <div>
          <button className="button danger" onClick={onClear}>Clear Cart</button>
        </div>
        <div style={{textAlign:'right'}}>
          <div style={{fontSize:14}}>Total:</div>
          <div style={{fontWeight:700, fontSize:20}}>₹{total.toFixed(2)}</div>
          <div style={{marginTop:8}}>
            <button className="button" onClick={onCheckout}>Checkout</button>
          </div>
        </div>
      </div>
    </div>
  );
}




import React, { useState, useEffect } from 'react';
import { CartItem as CI } from '@local/redux-lib';

export default function CartItem({
  item,
  onRemove,
  onSetQty
}: {
  item: CI;
  onRemove: () => void;
  onSetQty: (qty: number) => void;
}) {
  const [localQty, setLocalQty] = useState<number>(item.qty);

  useEffect(()=> { setLocalQty(item.qty); }, [item.qty]);

  const applyQty = (raw: number) => {
    const q = Math.max(0, Math.floor(isNaN(raw) ? 0 : raw));
    setLocalQty(q);
    // if 0 -> remove from cart (as per requirement)
    onSetQty(q);
  };

  return (
    <div style={{padding:10, borderBottom:'1px solid #eee', display:'flex', justifyContent:'space-between', alignItems:'center'}}>
      <div style={{flex:1}}>
        <div style={{fontWeight:600}}>{item.productCode} — {item.productName}</div>
        <div style={{fontSize:12, color:'#555'}}>{item.description}</div>
        <div style={{fontSize:13, marginTop:6}}>Unit: ₹{item.pricePerUnit.toFixed(2)} &nbsp; | &nbsp; Line: ₹{item.linePrice.toFixed(2)}</div>
      </div>

      <div style={{display:'flex', alignItems:'center', gap:8}}>
        <div className="qty-controls">
          <button className="small-button" onClick={()=> applyQty(localQty-1)}>-</button>
          <input className="qty-input" type="number" value={localQty} onChange={e => setLocalQty(Number(e.target.value))} onBlur={() => applyQty(localQty)} />
          <button className="small-button" onClick={()=> applyQty(localQty+1)}>+</button>
        </div>
        <div>
          <button className="small-button" onClick={onRemove}>Delete</button>
        </div>
      </div>
    </div>
  );
}




